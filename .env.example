APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=5000
# Optional existing Chromium/Chrome binary. Otherwise install Playwright Chromium.
CHROMIUM_EXECUTABLE=
# Production must use HTTPS and a shared limiter store with multiple workers.
RATELIMIT_STORAGE_URI=memory://
TRUSTED_HOSTS=localhost,127.0.0.1
EXPORT_TIMEOUT_SECONDS=40
